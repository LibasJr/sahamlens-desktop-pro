{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop capabilities for SahamLens Pro Cockpit v2",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://sahamlens.id/*" },
        { "url": "https://*.sahamlens.id/*" },
        { "url": "http://*/*" },
        { "url": "https://*/*" }
      ]
    }
  ]
}
