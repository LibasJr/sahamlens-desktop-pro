{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SahamLens Pro",
  "version": "1.0.1",
  "identifier": "id.sahamlens.pro",
  "build": {
    "devUrl": "https://sahamlens.id",
    "frontendDist": "https://sahamlens.id"
  },
  "app": {
    "windows": [
      {
        "title": "SahamLens Pro",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "SahamLens Desktop"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
